<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\YoursTruly.Core\YoursTruly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Twilio" Version="8.0.1" />
    <!-- MimeKit, under MailKit, asks for 10.0.0, which has two denial-of-service
         advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pinned to the first
         patched release until MimeKit asks for it itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
