<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Headings -->
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>
  <Style Selector="TextBlock.lede">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MaxWidth" Value="620"/>
    <!-- A MaxWidth on a stretched element centres it, which put every subtitle in the
         middle of the screen rather than under the heading it belongs to. -->
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ink3}"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
  </Style>

  <!-- Navigation rail -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Surface3}"/>
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Cards and surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
  </Style>
  <Style Selector="Border.drop">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="20,26"/>
  </Style>

  <!-- A notice with a severity stripe down its leading edge -->
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="3,1,1,1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="13,10"/>
  </Style>
  <Style Selector="Border.notice.privacy">
    <Setter Property="BorderBrush" Value="{DynamicResource Crit}"/>
  </Style>
  <Style Selector="Border.notice.caution">
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
    <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
  </Style>

  <!-- Data grid-ish list -->
  <Style Selector="TextBlock.colhead">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="0.8"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
  </Style>

  <!-- The three-way channel choice on each person's row -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style Selector="Button.chip.first"><Setter Property="CornerRadius" Value="7,0,0,7"/></Style>
  <Style Selector="Button.chip.last"><Setter Property="CornerRadius" Value="0,7,7,0"/></Style>
  <Style Selector="Button.chip.on.email">
    <Setter Property="Background" Value="{DynamicResource ChEmail}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChEmail}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="Button.chip.on.text">
    <Setter Property="Background" Value="{DynamicResource ChText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChText}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.chip.on.voice">
    <Setter Property="Background" Value="{DynamicResource ChVoice}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChVoice}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="14,7"/>
  </Style>
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="14,9"/>
  </Style>
  <Style Selector="Button.sortable">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Button.sortable:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
  </Style>

  <!-- A message in the history list -->
  <Style Selector="Button.sentrow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="14,11"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.sentrow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
  </Style>
  <Style Selector="Button.sentrow.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
</Styles>
