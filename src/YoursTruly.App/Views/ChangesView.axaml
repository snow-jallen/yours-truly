<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoursTruly.App.ViewModels"
             x:Class="YoursTruly.App.Views.ChangesView"
             x:DataType="vm:ChangesViewModel">

  <Grid Margin="28,26,28,24" RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0">
        <TextBlock Classes="h2" Text="Changes since import"/>
        <TextBlock Classes="lede" Margin="0,4,0,0"
                   Text="Details you have typed in here that the file you imported does not carry. Yours Truly never writes over what a file said, so a correction lives alongside it — which is what keeps it through every future import, and what leaves it sitting here until the two agree. Copy each one back into wherever your list comes from and tick it off, or leave it: an import that turns up carrying the same value clears it by itself."/>
      </StackPanel>
      <Button Grid.Column="1" Content="Copy all as a list" VerticalAlignment="Top"
              Command="{Binding CopyAllCommand}" IsVisible="{Binding !IsEmpty}"/>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,18,0,0" ClipToBounds="True"
            IsVisible="{Binding !IsEmpty}">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="header">
          <Grid ColumnDefinitions="2*,0.9*,2.2*,0.8*,Auto">
            <TextBlock Grid.Column="0" Classes="colhead" Text="NAME"/>
            <TextBlock Grid.Column="1" Classes="colhead" Text="FIELD"/>
            <TextBlock Grid.Column="2" Classes="colhead" Text="WHAT YOU TYPED"/>
            <TextBlock Grid.Column="3" Classes="colhead" Text="ADDED"/>
            <TextBlock Grid.Column="4" Classes="colhead" Text="" Width="150"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Name="ChangesScroller"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CorrectionRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="2*,0.9*,2.2*,0.8*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding PersonName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="12.5"
                               Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="mono"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding AddedOn}" Classes="mono"
                               Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Width="150">
                      <Button Content="Copy" Padding="10,4" FontSize="12.5"
                              Command="{Binding CopyCommand}"/>
                      <Button Content="Done" Padding="10,4" FontSize="12.5"
                              Command="{Binding DoneCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="24,30" Margin="0,18,0,0"
            VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
      <TextBlock Text="{Binding Summary}" HorizontalAlignment="Center"
                 Foreground="{DynamicResource Ink3}"/>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="0,9,0,0" FontSize="12"
               Foreground="{DynamicResource Ink3}" IsVisible="{Binding !IsEmpty}"/>
  </Grid>
</UserControl>
