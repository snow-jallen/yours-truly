<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoursTruly.App.ViewModels"
             x:Class="YoursTruly.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">

  <Grid Margin="28,26,28,24" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0">

      <TextBlock Classes="h2" Text="Import a file of people"/>
      <TextBlock Classes="lede" Margin="0,4,0,0"
                 Text="Open a PDF with people's names, email addresses and phone numbers in it — a roster, a class list, a directory export. Yours Truly works out the columns, shows you what it made of them, and asks where to keep the list. Nothing is saved until you say."/>

      <!-- Where these people are going. First, because it is the decision the rest of
           the screen is about: the numbers below are worked out against this list. -->
      <Border Classes="card" Margin="0,18,0,0" Padding="16,14">
        <StackPanel Spacing="8">
          <TextBlock Classes="eyebrow" Text="SAVE THESE PEOPLE INTO"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"/>
            <Button Grid.Column="1" Content="New list…" Command="{Binding NewListCommand}"/>
            <Button Grid.Column="2" Content="From a file…" Command="{Binding ExistingListCommand}"/>
          </Grid>
          <TextBlock Text="{Binding TargetPath}" Classes="mono" FontSize="11.5"
                     Foreground="{DynamicResource Ink3}" TextWrapping="Wrap"
                     IsVisible="{Binding HasTarget}"/>
          <TextBlock FontSize="12.5" TextWrapping="Wrap" MaxWidth="760"
                     Foreground="{DynamicResource Ink3}"
                     IsVisible="{Binding HasNoTargets}"
                     Text="There is no list yet. Press “New list…” and choose where to keep it — a list is your file, and it goes wherever you want it."/>
          <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="760"
                     Foreground="{DynamicResource Ink3}"
                     Text="An updated version of the same list goes back into the file it came from. A different set of people belongs in a file of its own, so importing one can never mark the other as gone."/>
        </StackPanel>
      </Border>

      <!-- Choose a file -->
      <Border Classes="drop" Margin="0,18,0,0" IsVisible="{Binding !HasFile}">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="Open a file" FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Ink}"/>
          <TextBlock Text="A PDF. Anything with names and a way of reaching people." FontSize="12.5"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Ink3}"/>
          <Button Classes="primary" Content="Choose a PDF…" Margin="0,12,0,0"
                  HorizontalAlignment="Center"
                  Command="{Binding ChooseFileCommand}" IsEnabled="{Binding !Busy}"/>
        </StackPanel>
      </Border>

    </StackPanel>

    <Grid Grid.Row="1" IsVisible="{Binding HasFile}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

      <Border Grid.Row="0" Classes="card" Margin="0,18,0,0" Padding="16,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding FileDetail}" Classes="mono" Foreground="{DynamicResource Ink3}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Choose another…" VerticalAlignment="Center"
                  Command="{Binding ChooseFileCommand}" IsEnabled="{Binding !Busy}"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="notice caution" Margin="0,12,0,0"
              IsVisible="{Binding GuessedColumns}">
        <TextBlock FontSize="12.5" TextWrapping="Wrap" MaxWidth="760"
                   Foreground="{DynamicResource Warn}"
                   Text="This file has no heading row Yours Truly could find, so it was read by looking for email addresses and phone numbers and taking whatever was left on the line as the name. Check the samples below before importing."/>
      </Border>

      <TextBlock Grid.Row="2" Classes="eyebrow" Text="WHAT EACH COLUMN IS" Margin="0,20,0,9"/>

      <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto">
          <Border Grid.Row="0" Classes="header">
            <Grid ColumnDefinitions="1.2*,2*,190">
              <TextBlock Grid.Column="0" Classes="colhead" Text="COLUMN"/>
              <TextBlock Grid.Column="1" Classes="colhead" Text="WHAT IS IN IT"/>
              <TextBlock Grid.Column="2" Classes="colhead" Text="IMPORT AS"/>
            </Grid>
          </Border>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColumnRow">
                <Border Classes="row">
                  <Grid ColumnDefinitions="1.2*,2*,190">
                    <TextBlock Grid.Column="0" Text="{Binding Heading}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Sample}" Classes="mono" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink3}"/>
                    <ComboBox Grid.Column="2" Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="8">
        <Border Classes="notice caution"
                IsVisible="{Binding MappingProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding MappingProblem}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="760"
                     Foreground="{DynamicResource Warn}"/>
        </Border>

        <TextBlock Text="{Binding GroupLine}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="760"
                   Foreground="{DynamicResource Ink2}"
                   IsVisible="{Binding GroupLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <CheckBox IsChecked="{Binding MarkMissingInactive}" IsVisible="{Binding IsReady}"
                  Content="Mark anyone missing from this file as no longer listed"/>
      </StackPanel>

      <!-- What this file would change -->
      <Border Grid.Row="5" Classes="card" Padding="0" ClipToBounds="True" Margin="0,16,0,0"
              IsVisible="{Binding IsReady}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Padding="0">
            <Grid ColumnDefinitions="*,*,*,*,*">
              <StackPanel Grid.Column="0" Margin="15,12">
                <TextBlock Text="{Binding InFile}" FontSize="23" FontWeight="Medium"
                           Foreground="{DynamicResource Ink}"/>
                <TextBlock Text="In the file" FontSize="11.5" Foreground="{DynamicResource Ink3}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="15,12">
                <TextBlock Text="{Binding Added}" FontSize="23" FontWeight="Medium"
                           Foreground="{DynamicResource Good}"/>
                <TextBlock Text="New people" FontSize="11.5" Foreground="{DynamicResource Ink3}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="15,12">
                <TextBlock Text="{Binding Updated}" FontSize="23" FontWeight="Medium"
                           Foreground="{DynamicResource Warn}"/>
                <TextBlock Text="Updated" FontSize="11.5" Foreground="{DynamicResource Ink3}"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="15,12">
                <TextBlock Text="{Binding Deactivated}" FontSize="23" FontWeight="Medium"
                           Foreground="{DynamicResource Crit}"/>
                <TextBlock Text="No longer listed" FontSize="11.5" Foreground="{DynamicResource Ink3}"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Margin="15,12">
                <TextBlock Text="{Binding Unchanged}" FontSize="23" FontWeight="Medium"
                           Foreground="{DynamicResource Ink}"/>
                <TextBlock Text="Unchanged" FontSize="11.5" Foreground="{DynamicResource Ink3}"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="1" Classes="eyebrow" Text="EVERY CHANGE" Margin="14,4,14,8"/>
          <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}"
                  BorderThickness="0,1,0,1" Padding="14,9">
            <Grid ColumnDefinitions="110,240,*">
              <TextBlock Grid.Column="0" Classes="colhead" Text="CHANGE"/>
              <TextBlock Grid.Column="1" Classes="colhead" Text="NAME"/>
              <TextBlock Grid.Column="2" Classes="colhead" Text="WHAT'S DIFFERENT"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="3" Name="ChangesScroller"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeRow">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
                    <Grid ColumnDefinitions="110,240,*">
                      <Panel Grid.Column="0" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource GoodSoft}" CornerRadius="20" Padding="8,2"
                                IsVisible="{Binding IsAdded}">
                          <TextBlock Text="New" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Good}"/>
                        </Border>
                        <Border Background="{DynamicResource WarnSoft}" CornerRadius="20" Padding="8,2"
                                IsVisible="{Binding IsUpdated}">
                          <TextBlock Text="Updated" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Warn}"/>
                        </Border>
                        <Border Background="{DynamicResource CritSoft}" CornerRadius="20" Padding="8,2"
                                IsVisible="{Binding IsGone}">
                          <TextBlock Text="Not listed" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Crit}"/>
                        </Border>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="20" Padding="8,2"
                                IsVisible="{Binding IsBack}">
                          <TextBlock Text="Back" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource AccentInk}"/>
                        </Border>
                      </Panel>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12.5"
                                 Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="9" Margin="0,18,0,0">
        <Button Classes="primary" Content="Import these people"
                Command="{Binding ApplyCommand}" IsEnabled="{Binding IsReady}"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding !Busy}"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,14,0,0" FontSize="12.5"
               TextWrapping="Wrap" MaxWidth="760"
               Foreground="{DynamicResource Ink2}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
  </Grid>
</UserControl>
