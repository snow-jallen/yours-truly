<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoursTruly.App.ViewModels"
             xmlns:data="using:YoursTruly.Data"
             x:Class="YoursTruly.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <Grid Margin="28,26,28,24" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0">
      <TextBlock Classes="h2" Text="What you have sent"/>
      <TextBlock Classes="lede" Margin="0,4,0,0"
                 Text="Every message, when it went, and what happened to each person's copy. Written as each one goes out, so it is a record rather than a guess."/>
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="24,34" Margin="0,18,0,0"
            VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
      <TextBlock Text="{Binding Summary}" HorizontalAlignment="Center" TextWrapping="Wrap"
                 MaxWidth="520" TextAlignment="Center" Foreground="{DynamicResource Ink3}"/>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="14" Margin="0,18,0,0"
          IsVisible="{Binding !IsEmpty}">

      <!-- The messages themselves -->
      <Border Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Batches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SentBatchRow">
                <Button Classes="sentrow" Classes.on="{Binding IsSelected}"
                        Command="{Binding OpenCommand}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding When}" Classes="mono" FontSize="11"
                               Foreground="{DynamicResource Ink3}"/>
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="13.5"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="{Binding Audience}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink3}"/>
                    <TextBlock Text="{Binding Outcome}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Good}" IsVisible="{Binding !AnyTrouble}"/>
                    <TextBlock Text="{Binding Outcome}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Warn}" IsVisible="{Binding AnyTrouble}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Who got it -->
      <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True"
              IsVisible="{Binding HasSelection}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Grid.Row="0" Margin="15,14,15,12" Spacing="5">
            <TextBlock Text="{Binding DetailHeadline}" FontWeight="SemiBold" FontSize="14"
                       TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
            <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="11,9"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" FontSize="12.5"
                         MaxLines="6" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Ink2}"/>
            </Border>
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="9" Margin="15,0,15,12">
            <TextBox Grid.Column="0" Text="{Binding Search}"
                     PlaceholderText="Find a person in this send"/>
            <Button Grid.Column="1" Content="Copy this record" Command="{Binding CopyCommand}"/>
          </Grid>

          <Border Grid.Row="2" Classes="header">
            <Grid ColumnDefinitions="2*,1.2*,2*,0.9*,0.7*">
              <TextBlock Grid.Column="0" Classes="colhead" Text="NAME"/>
              <TextBlock Grid.Column="1" Classes="colhead" Text="HOW"/>
              <TextBlock Grid.Column="2" Classes="colhead" Text="WHERE IT WENT"/>
              <TextBlock Grid.Column="3" Classes="colhead" Text="RESULT"/>
              <TextBlock Grid.Column="4" Classes="colhead" Text="TIME"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="3" Name="DeliveryScroller" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Deliveries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:SentDelivery">
                  <Border Classes="row">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="2*,1.2*,2*,0.9*,0.7*">
                        <TextBlock Grid.Column="0" Text="{Binding PersonName}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ChannelLabel}" FontSize="12.5"
                                   Foreground="{DynamicResource Ink2}"/>
                        <TextBlock Grid.Column="2" Text="{Binding AddressForDisplay}" Classes="mono"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Good}"
                                   IsVisible="{Binding Delivered}"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Crit}"
                                   IsVisible="{Binding Wrong}"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="12.5"
                                   Foreground="{DynamicResource Ink3}"
                                   IsVisible="{Binding !Delivered}"/>
                        <TextBlock Grid.Column="4" Text="{Binding When}" Classes="mono"
                                   Foreground="{DynamicResource Ink3}"/>
                      </Grid>
                      <TextBlock Text="{Binding Error}" FontSize="11.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Ink3}"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,9,0,0">
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Ink3}"
                 IsVisible="{Binding !IsEmpty}"/>
      <TextBlock Text="{Binding CopyStatus}" FontSize="12" Margin="0,3,0,0"
                 Foreground="{DynamicResource Good}"/>
    </StackPanel>
  </Grid>
</UserControl>
