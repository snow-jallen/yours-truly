<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YoursTruly.App.ViewModels"
        xmlns:views="using:YoursTruly.App.Views"
        x:Class="YoursTruly.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}" Width="1400" Height="900" MinWidth="1100" MinHeight="620"
        Icon="avares://YoursTruly.App/app-icon.png"
        Background="{DynamicResource Ground}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ImportViewModel">
      <views:ImportView/>
    </DataTemplate>
    <DataTemplate DataType="vm:NoListViewModel">
      <views:NoListView/>
    </DataTemplate>
    <DataTemplate DataType="vm:PeopleViewModel">
      <views:PeopleView/>
    </DataTemplate>
    <DataTemplate DataType="vm:GroupsViewModel">
      <views:GroupsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SendViewModel">
      <views:SendView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ChangesViewModel">
      <views:ChangesView/>
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <views:HistoryView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ScreenFailedViewModel">
      <StackPanel Margin="28,26" Spacing="10">
        <TextBlock Classes="h2" Text="That screen could not be opened"/>
        <Border Classes="notice privacy" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="640"
                     Foreground="{DynamicResource Ink2}"/>
        </Border>
        <TextBlock Classes="lede" Text="Nothing has been changed. Try another screen, or restart Yours Truly."/>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="216,*">

    <!-- Navigation rail -->
    <Border Grid.Column="0" Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="9" Margin="6,0,6,16">
          <!-- The mark itself rather than a letter in a coloured square. The icon
               carries its own dark tile, so it sits on the light theme and the dark
               one without needing a version of each. -->
          <Image Width="28" Height="28" Source="avares://YoursTruly.App/app-icon.png"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="yours truly" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="{Binding SenderLabel}" FontSize="9" LetterSpacing="0.6"
                       FontWeight="SemiBold" Foreground="{DynamicResource Ink3}"
                       TextWrapping="Wrap" MaxWidth="150"/>
          </StackPanel>
        </StackPanel>

        <!-- Which list is open. A soccer team, a class and a street are three
             different sets of people, so they are three files, and this is how you
             move between them. Naming and adding them is on the Setup screen. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="6,10,6,0" Margin="0,10,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Your list" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink2}"/>
            <ComboBox Name="ListSwitcher" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Lists}" SelectedItem="{Binding OpenList}"
                      PlaceholderText="No list open"/>
            <TextBlock Text="{Binding ListStatus}" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Crit}"
                       IsVisible="{Binding ListStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>

        <!-- Declared after the list block so it docks above it: a DockPanel stacks
             bottom-docked children outward in.

             One button doing both jobs — look for an update, then install the one it
             found. Deliberately the plain button rather than the accent one: worth
             noticing, not worth shouting over the list it sits above. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="6,10,6,0">
          <Button Content="{Binding UpdateButton}" Command="{Binding UpdateCommand}"
                  IsEnabled="{Binding !UpdateBusy}" FontSize="12"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <TextBlock Text="{Binding UpdateCaption}" FontSize="10.5"
                     Foreground="{DynamicResource Ink3}"
                     HorizontalAlignment="Center" TextWrapping="Wrap"
                     IsVisible="{Binding UpdateCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <StackPanel Spacing="2">
          <RadioButton Name="NavPeople" Classes="nav" GroupName="nav" IsChecked="True" Content="People"
                       Click="OnPeople"/>
          <RadioButton Name="NavGroups" Classes="nav" GroupName="nav" Content="Groups" Click="OnGroups"/>
          <RadioButton Name="NavSend" Classes="nav" GroupName="nav" Content="Send a message" Click="OnSend"/>
          <!-- Only offered when it has something on it. A permanent entry that usually
               says "nothing has changed" is one you learn to stop looking at. -->
          <RadioButton Name="NavChanges" Classes="nav" GroupName="nav" Content="Changes since import"
                       IsVisible="{Binding HasChanges}" Click="OnChanges"/>
          <RadioButton Name="NavHistory" Classes="nav" GroupName="nav" Content="Sent Messages" Click="OnHistory"/>
          <RadioButton Name="NavSetup" Classes="nav" GroupName="nav" Content="Setup" Click="OnSetup"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding Current}"/>
  </Grid>
</Window>
