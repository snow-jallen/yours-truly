<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/yourstruly.ico</ApplicationIcon>
    <!-- Only Version, and only as the default for a build from source. The release
         workflow passes -p:Version=1.0.<run number>, which supplies AssemblyVersion
         and FileVersion too — but only because neither is set here. Setting either
         one outright beats the command line, which is how every release from 1.0.1
         to 1.0.6 came to tell the user it was 1.0.0. ReleaseVersionTests keeps them
         out. -->
    <Version>1.0.0</Version>
    <Product>Yours Truly</Product>
    <Company>Yours Truly</Company>

    <!-- Published as a folder, not a single file: Velopack packages that folder into
         an installer and replaces it wholesale when updating, and cannot do either to a
         self-extracting executable. Not trimmed either — EF Core builds its model by
         reflection the trimmer cannot see, and a trimmed build fails at run time rather
         than at build time. -->
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YoursTruly.Core\YoursTruly.Core.csproj" />
    <ProjectReference Include="..\YoursTruly.Data\YoursTruly.Data.csproj" />
    <ProjectReference Include="..\YoursTruly.Messaging\YoursTruly.Messaging.csproj" />
  </ItemGroup>
</Project>
